<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gray"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="black"><color rgba="0.06 0.06 0.06 1.0"/></material>
  <material name="tread"><color rgba="0.22 0.22 0.22 1.0"/></material>
  <material name="yellow"><color rgba="1.0 0.9 0.0 1.0"/></material>

  <!-- Tune these to change tread appearance across all wheels -->
  <xacro:property name="wheel_radius"   value="0.0762"/>
  <xacro:property name="wheel_length"   value="0.04445"/>
  <xacro:property name="tread_diameter" value="0.012"/> <!-- groove depth in diameter units; inner_r = wheel_radius - tread_diameter/2 -->
  <xacro:property name="tread_count"    value="8"/>
  <xacro:property name="tread_gap"      value="0.008"/> <!-- tangential gap between blocks (m) -->

  <!-- Derived tread geometry (computed once from properties above) -->
  <xacro:property name="tread_inner_r" value="${wheel_radius - tread_diameter / 2.0}"/>
  <xacro:property name="tread_block_r" value="${wheel_radius - tread_diameter / 4.0}"/>
  <xacro:property name="tread_block_h" value="${tread_diameter / 2.0}"/>
  <xacro:property name="tread_block_w" value="${2.0 * pi * tread_block_r / tread_count - tread_gap}"/>
  <xacro:property name="tread_block_l" value="${wheel_length - 0.015}"/>

  <!-- Ground-projection frame: sits on the floor directly under base_link so the
       2D map/odom plane lands at the floor instead of through the chassis.
       0.1012 = wheel_joint z (0.025) + wheel_radius (0.0762). -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1012" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual><geometry><box size="0.254 0.2159 0.05"/></geometry><origin xyz="0 0 -0.025"/><material name="gray"/></visual>
    <visual><geometry><box size="0.127 0.0762 0.1016"/></geometry><origin xyz="-0.0635 0 0.0508"/><material name="yellow"/></visual>
    <collision><geometry><box size="0.254 0.2159 0.05"/></geometry></collision>
    <collision><geometry><box size="0.127 0.0762 0.1016"/></geometry><origin xyz="-0.0635 0 0.0508"/></collision>
    <inertial><mass value="2.7"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>

  <!-- Single tread block geometry, positioned by angle -->
  <xacro:macro name="tread_block" params="angle">
    <visual>
      <geometry><box size="${tread_block_h} ${tread_block_w} ${tread_block_l}"/></geometry>
      <origin xyz="${tread_block_r * cos(angle)} ${tread_block_r * sin(angle)} 0" rpy="0 0 ${angle}"/>
      <material name="tread"/>
    </visual>
  </xacro:macro>

  <!-- Recursively place n tread blocks evenly spaced by step radians -->
  <xacro:macro name="tread_blocks" params="n angle step">
    <xacro:if value="${n > 0}">
      <xacro:tread_block angle="${angle}"/>
      <xacro:tread_blocks n="${n - 1}" angle="${angle + step}" step="${step}"/>
    </xacro:if>
  </xacro:macro>

  <!-- Full tread: groove-floor cylinder + evenly spaced tread blocks -->
  <xacro:macro name="tread">
    <visual><geometry><cylinder radius="${tread_inner_r}" length="${wheel_length}"/></geometry><material name="black"/></visual>
    <xacro:tread_blocks n="${tread_count}" angle="0" step="${2.0 * pi / tread_count}"/>
  </xacro:macro>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <xacro:tread/>
      <collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry></collision>
      <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="${x} ${y} -0.025" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left"  x=" 0.1016" y=" 0.13335"/>
  <xacro:wheel name="front_right" x=" 0.1016" y="-0.13335"/>
  <xacro:wheel name="rear_left"   x="-0.1016" y=" 0.13335"/>
  <xacro:wheel name="rear_right"  x="-0.1016" y="-0.13335"/>

  <!-- RPLIDAR A2M12 — mounted in front of the yellow electronics box -->
  <xacro:property name="lidar_radius" value="0.0381"/>
  <xacro:property name="lidar_length" value="0.04445"/>
  <xacro:property name="lidar_x"      value="0.0508"/>  <!-- 2" forward of base_link -->
  <xacro:property name="lidar_z"      value="0.127"/>   <!-- 5" up from base_link -->

  <link name="laser">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
      <material name="lidar_blue"><color rgba="0.1 0.4 0.8 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry></collision>
    <inertial><mass value="0.17"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${lidar_x} 0.0 ${lidar_z}" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Intel RealSense D455 — rough model (~124 x 26 x 29 mm, W x H x D): grey
       bar body + black glass front. This link IS camera_link (the realsense
       root frame, +x forward), so the driver's optical frames hang off it. -->
  <xacro:macro name="d455_camera" params="name parent xyz rpy">
    <link name="${name}">
      <visual> <!-- grey body -->
        <geometry><box size="0.029 0.124 0.026"/></geometry>
        <material name="gray"/>
      </visual>
      <visual> <!-- black glass front (lens window) -->
        <origin xyz="0.0145 0 0"/>
        <geometry><box size="0.004 0.108 0.020"/></geometry>
        <material name="black"/>
      </visual>
      <inertial><mass value="0.072"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- 5" forward, 3.25" up from base_link -->
  <xacro:d455_camera name="camera_link" parent="base_link" rpy="0 0 0"
      xyz="0.127 0 0.08255"/>

</robot>
